# Copy to .env (never commit it).
# Password for admin.html. The API refuses to start without it.
ADMIN_PASSWORD=change-me
# Port the API listens on (the pages reach it at <site>/api/...).
PORT=5065
# Where tracks.json, patches/ and images/ are kept. Default: server/data
# DATA_DIR=/home/you/bonfirestack-web-data
# Extra secret for the admin login token (optional; the password is always part of it).
# SESSION_SECRET=
